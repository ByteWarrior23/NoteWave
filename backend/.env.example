# NoteWave AI Knowledge Hub Environment Configuration

# Primary Google Gemini API key
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Comma-separated pool for rotation on rate limits (recommended)
GOOGLE_API_KEYS=key1,key2,key3

# Gemini Models
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# Cross-Encoder Re-Ranking
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
TOP_K_CANDIDATES=20
TOP_K_FINAL=5
RRF_K=60

# Chunking Parameters (document-aware parent-child scheme)
PARENT_CHUNK_SIZE=1400
CHILD_CHUNK_SIZE=350
CHILD_CHUNK_OVERLAP=60

# Embedding cache bound (LRU, number of entries)
EMBED_CACHE_MAXSIZE=4096

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_PAGES_LIMIT=250

# Storage Paths
UPLOAD_DIR=documents
CHROMA_DIR=chroma_db
DATABASE_URL=sqlite:///./notewave.db

# Optional: Local Ollama fallback
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Optional: ElevenLabs for high-quality podcast TTS
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
